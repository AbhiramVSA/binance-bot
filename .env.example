# Binance Futures Trading Bot Environment Configuration
# Copy this file to .env and fill in your credentials

# Binance API credentials (get from https://testnet.binancefuture.com/)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Environment settings
USE_TESTNET=true

# Logging settings
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE_PATH=trading_bot.log
